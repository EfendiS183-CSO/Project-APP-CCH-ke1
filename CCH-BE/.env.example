# CCH-BE example environment (aman untuk di-commit; salin ke .env lalu isi secret)
# Referensi lengkap: README.md + internal/platform/config/config.go

# HTTP / DB
# Note: Laragon nginx occupies :8080, so the dev backend uses :8081.
# The backend loads .env automatically on startup (process env still wins).
CCH_BE_ADDR=:8081
CCH_DB_HOST=127.0.0.1
CCH_DB_PORT=3306
CCH_DB_USER=root
CCH_DB_PASSWORD=
CCH_DB_NAME=cch

# Staff JWT (HS512, minimal 32 byte)
CCH_JWT_SECRET=change-me
CCH_JWT_ISSUER=cch

# Call Center read/write (feature flags; default OFF)
CCH_ENABLE_CALL_CENTER_COMPLAINT_READ_API=false
CCH_ENABLE_CALL_CENTER_STATUS_WRITE_API=false
CCH_LEGACY_STATUS_WRITES_FENCED=false
CCH_ENABLE_CALL_CENTER_FOLLOWUP_PLAN_API=false
CCH_ENABLE_CALL_CENTER_FOLLOWUP_REALIZE_API=false
CCH_ENABLE_CALL_CENTER_FOLLOWUP_CANCEL_API=false
CCH_ENABLE_CALL_CENTER_FOLLOWUP_EDIT_API=false
CCH_ENABLE_CALL_CENTER_DOCUMENT_METADATA_API=false
CCH_ENABLE_CALL_CENTER_DOCUMENT_UPLOAD_API=false
CCH_ENABLE_CALL_CENTER_DOCUMENT_DOWNLOAD_API=false
CCH_ENABLE_CALL_CENTER_DOCUMENT_PREVIEW_API=false
CCH_ENABLE_CALL_CENTER_DOCUMENT_DELETE_API=false
CCH_ENABLE_CALL_CENTER_CUSTOMER_SEARCH_API=false

# Storage dokumen (untuk upload/download; wajib diisi jika flag dokumen di-on-kan)
CCH_DOCUMENT_STORAGE_ROOT=./var/storage
CCH_DOCUMENT_PUBLIC_ROOT=./var/public
CCH_DOCUMENT_CLAMAV_ADDRESS=

# Masters dan admin (default OFF)
CCH_ENABLE_COMPLAINT_TYPE_MASTER_API=false
CCH_ENABLE_COMPLAINT_SOURCE_MASTER_API=false
CCH_ENABLE_SHIPPING_SERVICE_MASTER_API=false
CCH_ENABLE_DOCUMENT_TYPE_MASTER_API=false
CCH_ENABLE_HANDLING_STATUS_MASTER_API=false
CCH_ENABLE_OFFICE_MASTER_API=false
CCH_ENABLE_FOLLOWUP_STATUS_MASTER_API=false
CCH_ENABLE_TIMEZONE_MASTER_API=false
CCH_ENABLE_HELP_CATEGORY_MASTER_API=false
CCH_ENABLE_HOLIDAY_CALENDAR_MASTER_API=false
CCH_ENABLE_LANGUAGES_MASTER_API=false
CCH_ENABLE_APP_SETTINGS_API=false
CCH_ENABLE_REGIONAL_ADMIN_API=false
CCH_ENABLE_CS_OFFICER_STATUS_API=false
CCH_ENABLE_USER_LEVEL_CATALOG_API=false
CCH_ENABLE_BREADCRUMB_LINKS_API=false
CCH_ENABLE_HELP_ARTICLE_API=false
CCH_ENABLE_ANNOUNCEMENT_API=false

# Guest intake (session token + submission/review; default OFF)
CCH_ENABLE_GUEST_INTAKE_SESSION_API=false
CCH_INTAKE_SESSION_SECRET=
CCH_INTAKE_SESSION_ISSUER=
CCH_INTAKE_SESSION_TTL=15m
CCH_INTAKE_ALLOWED_ORIGINS=http://localhost:5173
CCH_ENABLE_GUEST_INTAKE_SUBMISSION_API=false
CCH_INTAKE_CCH_API_BASE_URL=
CCH_INTAKE_CCH_USERNAME=
CCH_INTAKE_CCH_PASSWORD=
CCH_INTAKE_OFFICE_CODE=
CCH_ENABLE_GUEST_INTAKE_REVIEW_API=false